<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Earlier builds of Encore weren't sandboxed. On the first sandboxed launch, macOS moves
     their history and settings into the app's container, where the sandboxed app looks
     for them. -->
<dict>
	<key>Move</key>
	<array>
		<string>${ApplicationSupport}/Encore</string>
		<string>${Library}/Preferences/io.github.sudonicolas.encore.plist</string>
	</array>
</dict>
</plist>
